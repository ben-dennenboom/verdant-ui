{
    "name": "dennenboom/verdant-ui",
    "description": "A beautiful, self-contained UI component library for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dennenboom",
            "email": "info@dennenboom.be"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/pagination": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "burtds/laravel-vatnumber-checker": "*"
    },
    "autoload": {
        "psr-4": {
            "Dennenboom\\VerdantUI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dennenboom\\VerdantUI\\VerdantUIServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "npm install",
            "npm run build"
        ],
        "post-update-cmd": [
            "npm install",
            "npm run build"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.0"
    }
}