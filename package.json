{
    "name": "verdant-ui",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vp build --watch",
        "build": "vp check && vp build",
        "update": "npx --yes --package=vite-plus@latest vp migrate && ncu --interactive --reject vite,vite-plus --install never"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.7.2",
        "alpinejs": "^3.17.5",
        "cropperjs": "^1.7.0"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "laravel-vite-plugin": "^3.2.0",
        "npm-check-updates": "^23.1.1",
        "tailwindcss": "^4.3.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": "^11.20.0",
            "onFail": "download"
        }
    }
}
