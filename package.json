{
    "name": "verdant-ui",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vp build --watch",
        "build": "vp check && vp build",
        "fix": "vp check --fix",
        "update": "npx --yes --package=vite-plus@latest vp migrate && ncu --interactive --reject vite,vite-plus --install never && npm update"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.5",
        "alpinejs": "^3.17.5",
        "cropperjs": "^1.7.0",
        "laravel-vite-plugin": "^3.2.1",
        "npm-check-updates": "^23.1.1",
        "tailwindcss": "^4.3.5",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
        "vite-plus": "1.6.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=11.19.1"
        }
    }
}
